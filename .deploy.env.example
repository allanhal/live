# Copy to .deploy.env (gitignored) and fill in. Used by `pnpm deploy`.
DEPLOY_HOST=user@host
DEPLOY_KEY=~/.ssh/your_key          # optional, omit to use the ssh config
DEPLOY_PATH=/path/to/live-stream    # the checkout on the server
DEPLOY_SERVICE=live-stream          # systemd unit to restart
DEPLOY_PORT=3100                    # port to check healthz on, server-side
DEPLOY_URL=https://example.com      # optional, checked over TLS at the end
